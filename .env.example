# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-segura
# Defina "production" atrás de HTTPS (cookie secure + webhook exige secret)
NODE_ENV=
# Opcional: caminho do banco SQLite de sessões (padrão: storage/sessions.db).
# Não deixe definido vazio — descomente só se for usar.
# SESSION_DB_PATH=/app/storage/sessions.db

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
# Organização dona dos repositórios (padrão no código: Dive-Realities)
GITHUB_ORG=nome-da-org
# ID GraphQL (node ID) do Project v2 — começa com "PVT_", NÃO é o número do projeto.
# Obtenha com: gh api graphql -f query='{ organization(login:"ORG"){ projectV2(number:N){ id } } }'
GITHUB_PROJECT_ID=PVT_...

# ── Sprints ───────────────────────────────────────────────────────────────────
SPRINT_START_DATE=2026-04-20
SPRINT_DURATION_WEEKS=2

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=...
DISCORD_SERVER_ID=...

# ── Google OAuth (login do dashboard) ────────────────────────────────────────
# Crie em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
DASHBOARD_OAUTH_CLIENT_ID=...
DASHBOARD_OAUTH_CLIENT_SECRET=...

# ── Google APIs (Drive, Docs, Calendar) ──────────────────────────────────────
# OBRIGATÓRIOS: o servidor não sobe sem GOOGLE_CREDENTIALS_PATH e GOOGLE_TOKEN_PATH
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary
# Opcional: service account para o Calendar (alternativa ao token.json)
GOOGLE_SERVICE_ACCOUNT_PATH=
# Pastas do Drive onde as atas são salvas
DRIVE_ROOT_FOLDER_ID=
DRIVE_ATAS_FOLDER_NAME=01 - Gestão/Atas de reunião
DRIVE_COORD_ROOT_FOLDER_ID=root
DRIVE_COORD_FOLDER_NAME=Atas e Pautas Coordenação
# E-mails (separados por vírgula) com acesso às atas privadas de coordenação.
# Vazio = membros com "coordinator": true em data/members.json
COORD_SHARE_EMAILS=

# ── Automação de reuniões ─────────────────────────────────────────────────────
# OBRIGATÓRIOS: o servidor não sobe sem FIREFLIES_API_KEY, OPENAI_API_KEY e NOTION_TOKEN
FIREFLIES_API_KEY=
# Secret configurado no webhook do Fireflies. Obrigatório com NODE_ENV=production
# (sem ele, /webhooks/fireflies rejeita tudo em produção e aceita tudo em dev).
FIREFLIES_WEBHOOK_SECRET=
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_COORD_PAGE_ID=
# Opcional: bucket GCS para persistir estado (usado no Cloud Run)
GCS_BUCKET_NAME=

# ── URL pública ───────────────────────────────────────────────────────────────
# URL base pública do servidor (ex.: https://dashboard.exemplo.com), sem barra no final.
# Usada no redirect do login Google (<URL>/auth/callback) e no webhook do Fireflies.
# PUBLIC_WEBHOOK_URL tem prioridade; se vazio, usa PUBLIC_URL. Sem nenhum, o login
# redireciona para http://localhost:PORT/auth/callback.
PUBLIC_URL=
PUBLIC_WEBHOOK_URL=
# Alternativa em desenvolvimento: túnel ngrok (usado só se PUBLIC_URL estiver vazio)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
