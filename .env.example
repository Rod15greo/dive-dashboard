# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=troque-por-uma-string-aleatoria-segura

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_OWNER=nome-da-org-ou-usuario
GITHUB_PROJECT_NUMBER=1

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=...
DISCORD_SERVER_ID=...

# ── Google OAuth (login do dashboard) ────────────────────────────────────────
# Crie em: console.cloud.google.com → APIs → Credenciais → OAuth 2.0
DASHBOARD_OAUTH_CLIENT_ID=...
DASHBOARD_OAUTH_CLIENT_SECRET=...

# ── Google APIs (Drive, Docs, Calendar — para coleta de dados) ───────────────
# Opcional: necessário apenas para métricas de Drive e Calendar
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
GOOGLE_CALENDAR_ID=primary

# ── Automação de reuniões (opcional) ─────────────────────────────────────────
# Necessário apenas se quiser processar atas automaticamente via Fireflies
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_COORD_PAGE_ID=

# ── URL pública (para webhooks do Fireflies) ──────────────────────────────────
# Se usar proxy reverso ou tunnel, defina aqui. Caso contrário, deixe vazio.
PUBLIC_URL=
